-                        if (acc_pts * G6 >= tot * g) cut[static_cast<size_t>(g++)] = p + 1;
+                        acc_w += wcost[static_cast<size_t>(p)];
+                        if (acc_w * G6 >= tot * g) cut[static_cast<size_t>(g++)] = p + 1;
                     }
                 }
                 int dev0 = 0;
