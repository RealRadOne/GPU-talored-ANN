diff --git a/bucketDemo/buildBucket/src/knn_compact.hpp b/bucketDemo/buildBucket/src/knn_compact.hpp
new file mode 100644
index 0000000..8216b5f
--- /dev/null
+++ b/bucketDemo/buildBucket/src/knn_compact.hpp
@@ -0,0 +1,170 @@
+#pragma once
+// S7 (scale loop): 紧凑 vector_knn 格式 (无损，读回后逐位相同)。
+//
+// SIFT100M 的 vector_knn.bin 是 N·M·4 B = 25.6 GB，bucket2 最终 merge 写它时被 dirty 页阈值限速 (G=2 时整条流水线
+// 卡在写盘字节数上，见 OPTIMIZATION_LOG_SCALE.md S3–S6)。重排后近邻 id 跟本点 id 接近:
+// zigzag(nbr − gid) 的 varint 平均 ~3 B/id (sift10M 实测 3.03)。
+//
+// 格式 (文件名不变，靠 magic 区分; 老格式开头是正的 int64 N，老读者遇到新文件会报 header 无效而不是读错):
+//   Header   { uint64 magic; int64 N; int32 M; int32 B; uint64 n_groups }      (32 B)
+//   GroupEnt { uint64 off; uint32 bytes; uint32 pad } × n_groups               (行 [g·B, min(N,(g+1)·B)) 的数据位置)
+//   数据: 每行 M 个 varint(zigzag(nbr − gid))，一组内按行连续
+// 读任意行区间 [lo, lo+n): 只读覆盖它的组 (相邻组在文件里连续时合成一次 pread)，从组首逐行解码。
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace knn_compact {
+
+constexpr uint64_t kMagic = 0x80000000314E4B43ull;   // "CKN1" + 最高位 (老读者把它当 N < 0 → header 无效)
+constexpr int32_t kGroupRows = 256;
+
+struct Header { uint64_t magic; int64_t N; int32_t M; int32_t B; uint64_t n_groups; };
+struct GroupEnt { uint64_t off; uint32_t bytes; uint32_t pad; };
+static_assert(sizeof(Header) == 32 && sizeof(GroupEnt) == 16, "knn_compact: layout");
+
+inline uint64_t n_groups_of(int64_t N, int32_t B) { return static_cast<uint64_t>((N + B - 1) / B); }
+inline uint64_t data_start(uint64_t n_groups) { return sizeof(Header) + n_groups * sizeof(GroupEnt); }
+inline size_t max_row_bytes(int M) { return static_cast<size_t>(M) * 10; }
+
+// 行 gid0 .. gid0+n-1 (每行 M 个 int32，-1 = 空位) 编码追加到 out，返回追加的字节数
+inline size_t encode_rows(const int32_t* rows, int64_t gid0, int64_t n, int M, std::vector<char>& out) {
+    const size_t start = out.size();
+    out.resize(start + static_cast<size_t>(n) * max_row_bytes(M));
+    char* p = out.data() + start;
+    for (int64_t r = 0; r < n; ++r) {
+        const int64_t gid = gid0 + r;
+        const int32_t* row = rows + static_cast<size_t>(r) * M;
+        for (int m = 0; m < M; ++m) {
+            const int64_t d = static_cast<int64_t>(row[m]) - gid;
+            uint64_t z = (static_cast<uint64_t>(d) << 1) ^ static_cast<uint64_t>(d >> 63);
+            while (z >= 0x80) { *p++ = static_cast<char>(z | 0x80); z >>= 7; }
+            *p++ = static_cast<char>(z);
+        }
+    }
+    const size_t used = static_cast<size_t>(p - (out.data() + start));
+    out.resize(start + used);
+    return used;
+}
+
+// 从 p 开始解 n 行 (首行 id = gid0) 到 out；越界 / 格式错返回 nullptr
+inline const char* decode_rows(const char* p, const char* end, int64_t gid0, int64_t n, int M, int32_t* out) {
+    for (int64_t r = 0; r < n; ++r) {
+        const int64_t gid = gid0 + r;
+        for (int m = 0; m < M; ++m) {
+            uint64_t z = 0;
+            for (int sh = 0;; sh += 7) {
+                if (p >= end || sh > 63) return nullptr;
+                const uint64_t b = static_cast<uint8_t>(*p++);
+                z |= (b & 0x7f) << sh;
+                if (!(b & 0x80)) break;
+            }
+            const int64_t d = static_cast<int64_t>(z >> 1) ^ -static_cast<int64_t>(z & 1);
+            out[static_cast<size_t>(r) * M + m] = static_cast<int32_t>(gid + d);
+        }
+    }
+    return p;
+}
+
+inline void pread_full(int fd, char* p, size_t n, off_t off, const std::string& what) {
+    while (n > 0) {
+        const ssize_t r = ::pread(fd, p, n, off);
+        if (r <= 0) throw std::runtime_error("knn_compact: short read on " + what);
+        p += r; n -= static_cast<size_t>(r); off += r;
+    }
+}
+
+// 两种格式都能读的行区间读者 (read_rows 线程安全: 只用 pread，不碰共享状态)
+class AnyReader {
+public:
+    explicit AnyReader(const std::string& path) : path_(path) {
+        fd_ = ::open(path.c_str(), O_RDONLY);
+        if (fd_ < 0) throw std::runtime_error("Cannot open vector_knn: " + path);
+        uint64_t first = 0;
+        pread_full(fd_, reinterpret_cast<char*>(&first), sizeof(first), 0, path);
+        if (first == kMagic) {
+            Header h;
+            pread_full(fd_, reinterpret_cast<char*>(&h), sizeof(h), 0, path);
+            if (h.N <= 0 || h.M <= 0 || h.B <= 0 || h.n_groups != n_groups_of(h.N, h.B))
+                throw std::runtime_error("Invalid compact vector_knn header: " + path);
+            compact_ = true; N_ = h.N; M_ = h.M; B_ = h.B;
+            groups_.resize(static_cast<size_t>(h.n_groups));
+            pread_full(fd_, reinterpret_cast<char*>(groups_.data()), groups_.size() * sizeof(GroupEnt),
+                       static_cast<off_t>(sizeof(Header)), path);
+        } else {
+            int32_t M = 0;
+            pread_full(fd_, reinterpret_cast<char*>(&M), sizeof(M), sizeof(int64_t), path);
+            N_ = static_cast<int64_t>(first); M_ = M;
+            if (N_ <= 0 || M_ <= 0) throw std::runtime_error("Invalid vector_knn header: " + path);
+        }
+    }
+    ~AnyReader() { if (fd_ >= 0) ::close(fd_); }
+    AnyReader(const AnyReader&) = delete;
+    AnyReader& operator=(const AnyReader&) = delete;
+
+    int64_t N() const { return N_; }
+    int32_t M() const { return M_; }
+    bool compact() const { return compact_; }
+
+    // 行 [lo, lo+n) → out (n·M 个 int32)
+    void read_rows(int64_t lo, int64_t n, int32_t* out) const {
+        if (n <= 0) return;
+        if (lo < 0 || lo + n > N_) throw std::runtime_error("knn_compact: rows out of range");   // bounds check
+        if (!compact_) {
+            pread_full(fd_, reinterpret_cast<char*>(out), static_cast<size_t>(n) * M_ * sizeof(int32_t),
+                       static_cast<off_t>(sizeof(int64_t) + sizeof(int32_t)) + static_cast<off_t>(lo) * M_ * sizeof(int32_t),
+                       path_);
+            return;
+        }
+        thread_local std::vector<char> buf;
+        thread_local std::vector<int32_t> tmp;
+        const int64_t g0 = lo / B_, g1 = (lo + n - 1) / B_;
+        int64_t g = g0;
+        while (g <= g1) {
+            // 文件里连续的一串组合成一次 pread
+            int64_t ge = g;
+            uint64_t span = groups_[static_cast<size_t>(g)].bytes;
+            while (ge + 1 <= g1 && groups_[static_cast<size_t>(ge + 1)].off ==
+                                   groups_[static_cast<size_t>(ge)].off + groups_[static_cast<size_t>(ge)].bytes) {
+                ++ge; span += groups_[static_cast<size_t>(ge)].bytes;
+            }
+            buf.resize(static_cast<size_t>(span));
+            pread_full(fd_, buf.data(), static_cast<size_t>(span), static_cast<off_t>(groups_[static_cast<size_t>(g)].off), path_);
+            const char* p = buf.data();
+            const char* const end = buf.data() + buf.size();
+            for (int64_t gg = g; gg <= ge; ++gg) {
+                const int64_t r0 = gg * B_, r1 = std::min<int64_t>(N_, r0 + B_);
+                const int64_t want0 = std::max(lo, r0), want1 = std::min(lo + n, r1);
+                const char* gend = p + groups_[static_cast<size_t>(gg)].bytes;
+                if (want0 == r0) {   // 从组首开始要: 直接解进 out，组尾不要的行不解
+                    if (!decode_rows(p, gend, r0, want1 - r0, M_, out + static_cast<size_t>(want0 - lo) * M_))
+                        throw std::runtime_error("knn_compact: corrupt group " + std::to_string(gg) + " in " + path_);
+                } else {             // 组中间开始: 先解到 tmp 再拷要的行
+                    tmp.resize(static_cast<size_t>(want1 - r0) * M_);
+                    if (!decode_rows(p, gend, r0, want1 - r0, M_, tmp.data()))
+                        throw std::runtime_error("knn_compact: corrupt group " + std::to_string(gg) + " in " + path_);
+                    std::memcpy(out + static_cast<size_t>(want0 - lo) * M_, tmp.data() + static_cast<size_t>(want0 - r0) * M_,
+                                static_cast<size_t>(want1 - want0) * M_ * sizeof(int32_t));
+                }
+                p = gend;
+                if (p > end) throw std::runtime_error("knn_compact: group table overruns span in " + path_);
+            }
+            g = ge + 1;
+        }
+    }
+
+private:
+    std::string path_;
+    int fd_ = -1;
+    bool compact_ = false;
+    int64_t N_ = 0;
+    int32_t M_ = 0, B_ = 0;
+    std::vector<GroupEnt> groups_;
+};
+
+}  // namespace knn_compact
