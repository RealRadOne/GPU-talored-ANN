 // 多线程 pread 一段文件到 dst (每线程读自己的子区间；页面首次触碰也随之
 // 并行，而不是一个线程串行 page-fault 几百 MB)。
+// S8 / P1 (scale loop): 多 GPU 剪枝时每张卡一个写线程。GPU 线程的 sink 只把 pinned 暂存区里的行拷进有界队列就返回，
+// 写线程按偏移 pwrite (writer.write_rows_at，跟原来同一个调用 → 输出逐字节相同)。原来 GPU 线程在 finish(c-1) 里
+// 自己 pwrite，被 dirty 页限速 / ext4 同一 inode 的写锁卡住时，这张卡下一块的 plan / load / kernel 全都排在后面。
+// 参考 TAGORE largeIndex: GPU 构建跟 CPU / 磁盘写出用独立线程流水；cuVS snmg 每个 rank 自己的资源。
+class AsyncRowSink {
+public:
+    AsyncRowSink(graph_io::StreamingGraphWriter& w, int32_t row_w, size_t cap_bytes)
+        : w_(w), row_w_(row_w), cap_(cap_bytes), th_([this] { loop(); }) {}
+    ~AsyncRowSink() { try { finish(); } catch (...) {} }   // 正常路径显式 finish() (错误在那里抛)
+    // GPU 线程调用: 拷一份 (rows 只在回调期间有效)，队列满了就等 (返回阻塞秒数)
+    double push(const uint32_t* rows, int64_t row0, int64_t n) {
+        const auto t0 = std::chrono::steady_clock::now();
+        Item it{std::vector<uint32_t>(rows, rows + static_cast<size_t>(n) * row_w_), row0, n};
+        const size_t bytes = it.rows.size() * sizeof(uint32_t);
+        std::unique_lock<std::mutex> lk(m_);
+        cv_.wait(lk, [&] { return err_ || queued_ == 0 || queued_ + bytes <= cap_; });
+        if (err_) std::rethrow_exception(err_);
+        queued_ += bytes; q_.push_back(std::move(it));
+        cv_.notify_all();
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    }
+    // 等队列写完、收线程 (返回等待秒数)
+    double finish() {
+        const auto t0 = std::chrono::steady_clock::now();
+        { std::lock_guard<std::mutex> lk(m_); done_ = true; }
+        cv_.notify_all();
+        if (th_.joinable()) th_.join();
+        if (err_) std::rethrow_exception(err_);
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    }
+    double write_s() const { return write_s_; }
+private:
+    struct Item { std::vector<uint32_t> rows; int64_t row0, n; };
+    void loop() {
+        for (;;) {
+            Item it;
+            {
+                std::unique_lock<std::mutex> lk(m_);
+                cv_.wait(lk, [&] { return done_ || !q_.empty(); });
+                if (q_.empty()) return;   // done_ 且已写完
+                it = std::move(q_.front()); q_.pop_front();
+            }
+            try {
+                const auto t0 = std::chrono::steady_clock::now();
+                w_.write_rows_at(it.rows.data(), it.row0, it.n);
+                write_s_ += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            } catch (...) {
+                std::lock_guard<std::mutex> lk(m_); err_ = std::current_exception(); cv_.notify_all(); return;
+            }
+            std::lock_guard<std::mutex> lk(m_);
+            queued_ -= it.rows.size() * sizeof(uint32_t);
+            cv_.notify_all();
+        }
+    }
+    graph_io::StreamingGraphWriter& w_;
+    int32_t row_w_;
+    size_t cap_, queued_ = 0;
+    bool done_ = false;
+    std::exception_ptr err_;
+    double write_s_ = 0;
+    std::deque<Item> q_;
+    std::mutex m_;
+    std::condition_variable cv_;
+    std::thread th_;   // 最后初始化 (用到上面的成员)
+};
